{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plum3 de Nyx",
  "version": "0.1.0",
  "identifier": "os.ph3ynyx.plum3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plum3 de Nyx",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
